{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{model/**,model_data.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/index.py?__route=predict"
    },
    {
      "source": "/model-info",
      "destination": "/api/index.py?__route=model-info"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__route=health"
    },
    {
      "source": "/shap/:path*",
      "destination": "/api/index.py?__route=shap&path=:path*"
    },
    {
      "source": "/download-report",
      "destination": "/api/index.py?__route=download-report"
    }
  ]
}
