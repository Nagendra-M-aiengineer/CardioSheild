{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{model/**,model_data.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/index.py"
    },
    {
      "source": "/model-info",
      "destination": "/api/index.py"
    },
    {
      "source": "/shap/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/history",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}
